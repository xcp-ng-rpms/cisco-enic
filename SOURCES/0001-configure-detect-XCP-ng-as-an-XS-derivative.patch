From b8756bd247e02cd84502ff5e49e105630842c8bd Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Thu, 3 Sep 2026 11:19:14 +0200
Subject: [PATCH] configure: detect XCP-ng as an XS derivative.

This prevents a build error at the configuring stage:

  checking Linux distribution...  /
  configure: WARNING: Unsupported linux distribution
  configure: error: cannot continue

Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 configure | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/configure b/configure
index cff45e8352fa..180a998a42a3 100755
--- a/configure
+++ b/configure
@@ -3326,7 +3326,7 @@ $as_echo_n "checking Linux distribution... " >&6; }
             # (which is a sym link to /etc/centos-release).
             centos_field=4
 
-        elif test -n "`echo $NAME | grep Xen`"; then
+        elif test -n "`echo $NAME | grep -e Xen -e XCP-ng`"; then
             XS_MAJOR=`echo $VERSION_ID | cut -d. -f1`
             XS_MINOR=`echo $VERSION_ID | cut -d. -f2`
 
@@ -12290,4 +12290,3 @@ if test -n "$ac_unrecognized_opts" && test "$enable_option_checking" != no; then
   { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: unrecognized options: $ac_unrecognized_opts" >&5
 $as_echo "$as_me: WARNING: unrecognized options: $ac_unrecognized_opts" >&2;}
 fi
-
